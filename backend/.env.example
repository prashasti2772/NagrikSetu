# Reference values: set these as PowerShell environment variables before startup.
# This application reads the process environment; it does not load .env files.
APP_NAME=NagrikSetu API
# Default: an absolute path to backend/nagriksetu.db.
# Relative SQLite paths are resolved against the working directory.
DATABASE_URL=sqlite:///./nagriksetu.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
