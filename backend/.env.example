# Reference values only. Set these in the process environment (e.g. PowerShell).
# Optional Gemini/Brevo/Supabase Storage values also load from ignored backend/.env.
APP_NAME=NagrikSetu API
# Missing or blank uses the existing backend/nagriksetu.db file.
# PostgreSQL: postgresql+pg8000://USER:URL_ENCODED_PASSWORD@HOST:5432/DATABASE
# PostgreSQL uses verified TLS by default; see README.md for local options.
DATABASE_URL=
# Use a persistent random secret of at least 32 characters for deployment.
# Development with a blank secret generates an ephemeral key on each process start.
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

APP_ENV=development
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=NagrikSetu
OTP_EXPIRE_MINUTES=10

# Local text intelligence: advisory only; no network calls.
DUPLICATE_THRESHOLD=0.65
DUPLICATE_LOOKBACK_DAYS=90
DUPLICATE_CANDIDATE_LIMIT=500
# Per peer IP, per process, per endpoint; no Redis dependency.
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_LOGIN=10
RATE_LIMIT_REGISTER=5
RATE_LIMIT_FORGOT=5
RATE_LIMIT_VERIFY=10
RATE_LIMIT_INTELLIGENCE=20

# Optional Gemini chatbot/image assistance; blank keeps the local fallback active.
GEMINI_API_KEY=
GEMINI_MODEL=

# Optional private evidence storage; unrelated to DATABASE_URL/PostgreSQL.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=complaint-evidence
EVIDENCE_MAX_BYTES=10485760

# BHASHINI support remains disabled pending approval; no credentials are read.
BHASHINI_ENABLED=false
